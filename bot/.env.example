# Discord Bot Configuration
# Get these from https://discord.com/developers/applications

# Bot token (from Bot settings)
DISCORD_BOT_TOKEN=

# Client ID (from OAuth2 settings)
DISCORD_CLIENT_ID=

# Guild ID for development (optional - enables instant command updates)
# Right-click your server and "Copy Server ID" (requires Developer Mode)
DISCORD_GUILD_ID=

# Database URL (same as main Wurm Tools app)
DATABASE_URL=mysql://user:password@localhost:3306/wurmtools

# Wurm Tools web app URL (for links in embeds)
APP_URL=https://wurm.tools
