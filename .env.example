# WURM-TOOLS Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE CONFIGURATION (MySQL/MariaDB - Required)
# =============================================================================

# MySQL/MariaDB connection string (REQUIRED)
# Format: mysql://username:password@hostname:port/database_name
DATABASE_URL=mysql://wurmtools:your_password@localhost:3306/wurmtools

# Examples:
# DATABASE_URL=mysql://wurmtools:mypassword@localhost:3306/wurmtools
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/wurm_tools
# DATABASE_URL=mariadb://wurmtools:mypassword@192.168.1.100:3306/wurmtools

# SSL Configuration (optional, for secure connections)
# DATABASE_SSL=true                        # Enable SSL (default: false)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true    # Reject self-signed certs (default: true)

# Connection Pooling (optional)
# DATABASE_POOL_MIN=2                      # Minimum pool size (default: 2)
# DATABASE_POOL_MAX=10                     # Maximum pool size (default: 10)

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode
NODE_ENV=development

# Application URL (set this in production)
# NEXT_PUBLIC_APP_URL=https://wurm-tools.example.com

# =============================================================================
# OPTIONAL: SECURITY SETTINGS
# =============================================================================

# Session secret (auto-generated if not set, but recommended to set in production)
# SESSION_SECRET=your-very-long-random-secret-key-min-32-chars

# Rate limiting (requests per minute)
# RATE_LIMIT_GENERAL=100
# RATE_LIMIT_AUTH=10

# =============================================================================
# GOOGLE DRIVE API CONFIGURATION (Optional - for community resource sync)
# =============================================================================

# Google Drive API Key (for public folder access)
# GOOGLE_DRIVE_API_KEY=your_google_api_key

# Service Account Email (recommended for automated sync)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Service Account Key (JSON as single line, or path to file)
# Option 1: Paste the entire JSON as a single line
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Option 2: Path to the downloaded JSON file
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account-key.json

# Community folder configuration
GOOGLE_DRIVE_COMMUNITY_FOLDER_ID=0B6J_aGQ6URL8UURFN2VadWxtSWs
GOOGLE_DRIVE_RESOURCE_KEY=0-DuurGPuGLSABmTTu7-999g

# Sync settings
DRIVE_SYNC_INTERVAL_HOURS=6
DRIVE_SYNC_AUTO_ENABLED=true
DRIVE_MAX_FILE_SIZE_MB=100

# Google Drive Setup Instructions:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google Drive API
# 4. Create Service Account credentials
# 5. Download the JSON key file
# 6. Share your Google Drive folder with the service account email
# 7. Add the credentials to this file

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Create MySQL/MariaDB database:
#    CREATE DATABASE wurmtools CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# 2. Create database user:
#    CREATE USER 'wurmtools'@'localhost' IDENTIFIED BY 'your_password';
#    GRANT ALL PRIVILEGES ON wurmtools.* TO 'wurmtools'@'localhost';
#    FLUSH PRIVILEGES;
#
# 3. Run the schema files:
#    mysql -u wurmtools -p wurmtools < scripts/schema-mysql.sql
#    mysql -u wurmtools -p wurmtools < scripts/schema-player-hub.sql
#
# 4. Copy this file to .env.local and update DATABASE_URL
#
