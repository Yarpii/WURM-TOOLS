# WURM-TOOLS Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# For SQLite (local development - default):
# Leave DATABASE_URL empty or don't set it

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# Examples:
# DATABASE_URL=postgresql://wurmtools:mypassword@localhost:5432/wurmtools
# DATABASE_URL=postgresql://wurmtools:mypassword@192.168.1.100:5432/wurmtools?sslmode=require

# SSL Configuration (for PostgreSQL)
# DATABASE_SSL=true                        # Enable SSL (default: true)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true    # Reject self-signed certs (default: true)

# Connection Pooling (for PostgreSQL)
# DATABASE_POOL_MIN=2                      # Minimum pool size (default: 2)
# DATABASE_POOL_MAX=10                     # Maximum pool size (default: 10)

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode
NODE_ENV=development

# Application URL (for production)
# NEXT_PUBLIC_APP_URL=https://wurm-tools.example.com

# =============================================================================
# OPTIONAL: ADVANCED SETTINGS
# =============================================================================

# Session secret (auto-generated if not set)
# SESSION_SECRET=your-very-long-random-secret-key

# Rate limiting (requests per minute)
# RATE_LIMIT_GENERAL=100
# RATE_LIMIT_AUTH=10
